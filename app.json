{
  "expo": {
    "name": "Ping",
    "slug": "ping",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "ping",
    "plugins": ["expo-router"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "social.ping.app" },
    "android": { "package": "social.ping.app", "adaptiveIcon": { "backgroundColor": "#FFFFFF" } },
    "web": { "bundler": "metro" },
    "experiments": { "typedRoutes": true }
  }
}
